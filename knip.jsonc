{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  // See https://knip.dev/reference/issue-types for details on each rule.
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "catalog": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "duplicates": "error",
    // Set as "off" because SDK enums intentionally include all possible values.
    "enumMembers": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "classMembers": "off"
  },
  "workspaces": {
    // Root
    ".": {
      "entry": ["scripts/compat/worker.mjs"],
      "project": ["*.{js,mjs,ts}", "scripts/**/*.{mjs,ts}"]
    },

    // Packages
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/agents-telemetry": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@opentelemetry/api",
        "@opentelemetry/api-logs"
      ]
    },
    "packages/agents-activity": {
      "project": ["src/**/*.ts"],
      "ignore": [
         // Ignore fake module used in browser builds by esbuild.
        "src/browser/crypto.ts"
      ]
    },
    "packages/agents-copilotstudio-client": {
      "project": ["src/**/*.ts"],
      "ignore": [
         // Ignore fake module used in browser builds by esbuild.
        "src/browser/os.ts",
        "src/browser/crypto.ts"
      ]
    },
    "packages/*/test": {
      "entry": ["**/*.test.ts"],
      "project": ["**/*.ts"]
    },

    "samples": {
      "entry": [
        "_shared/githubApiClient.ts",
        "basic/cardsWithInvoke.ts",
        "basic/longRunning.ts",
        "basic/messageReactions.ts",
        "basic/proactive.ts",
        "basic/typeAheadSearch.ts",
        "compat/adaptiveCardsHandler.ts",
        "compat/cardFactoryHandler.ts",
        "compat/multiFeatureHandler.ts",
        "compat/stateManagementHandler.ts",
        "state/blob2Cnx.ts",
        "state/blobDemo.ts",
        "state/stateDemo.ts",
        "state/userState.ts",
        "teams/cardActions.ts",
        "teams/meetingsExample.ts",
        "teams/msgExtensionExample.ts",
        "teams/taskModuleExample.ts",
        "teams/teamsAttachments.ts",
        "teams/teamsConversationExample.ts"
      ],
      "project": ["**/*.{ts,mjs}"]
    },

    // Test agents
    "test-agents/*": {
      "entry": ["src/**/*.ts"],
      "project": ["**/*.ts"]
    },
    "test-agents/state-agent": {
      "entry": ["src/**/*.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": [
        // Ignore sample as it has the cosmos dependency commented out to switch with blobs.
        "@microsoft/agents-hosting-storage-cosmos"
      ]
    }
  }
}
