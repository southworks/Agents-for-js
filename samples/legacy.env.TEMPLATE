# Legacy mode uses current SDK interfaces and legacy OAuth settings.
# Restart the coordinator after changing this file.

# Host settings. Bot credentials are optional for local Playground testing.
PORT=3978

# Optional SDK debug logging.
# DEBUG=agents:*:error,agents:app:*,agents:authorization:*

# Bot credentials. Named host connections also work in Legacy.
# The default bot connection handles OBO unless you configure another one.
clientId=
clientSecret=
tenantId=

# OAuth handlers. Match these names to the Azure Bot OAuth connections.
# auth
auth_connectionName=AuthConnection
auth_connectionTitle=Auth Sign In
auth_connectionText=Sign in with OAuth enabled

# sso
sso_connectionName=SsoConnection
sso_connectionTitle=SSO Sign In
sso_connectionText=Sign in with SSO and exchange a downstream token

# obo_auto
obo_auto_connectionName=OboAutoConnection
obo_auto_connectionTitle=OBO Auto Sign In
obo_auto_connectionText=Sign in with the OBO-capable flow
obo_auto_obo_scopes=https://graph.microsoft.com/.default

# obo_manual
obo_manual_connectionName=OboManualConnection
obo_manual_connectionTitle=OBO Manual Sign In
obo_manual_connectionText=Sign in and exchange a downstream token

# Copilot Studio. Fill in the published agent IDs and use a separate OAuth connection.
environmentId=
schemaName=
mcs_connectionName=CopilotStudioConnection
